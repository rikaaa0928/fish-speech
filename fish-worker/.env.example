# Manager WebSocket endpoint used by this GPU worker to register itself.
# Default/example: wss://manager.example.com/internal/workers/ws
MANAGER_URL=wss://manager.example.com/internal/workers/ws

# Shared worker registration token. Must match the manager-side worker token.
# Default/example: replace-me
WORKER_TOKEN=replace-me

# Optional stable worker ID. Leave empty to generate worker-<random> on startup.
# Default: empty
WORKER_ID=

# Docker host directory mounted into the container for model files.
# Default: ./models
HOST_MODEL_DIR=./models

# Docker host directory mounted into the container for cache/download files.
# Default: ./cache
HOST_CACHE_DIR=./cache

# Container path corresponding to HOST_MODEL_DIR.
# Default: /models
CONTAINER_MODEL_DIR=/models

# Container path corresponding to HOST_CACHE_DIR.
# Default: /cache
CONTAINER_CACHE_DIR=/cache

# Hugging Face endpoint used by download tools. Use https://huggingface.co if no mirror is needed.
# Default: https://hf-mirror.com
HF_ENDPOINT=https://hf-mirror.com

# Path where hfd.sh is stored. Docker default is /cache/hfd.sh.
# Default: /cache/hfd.sh
HFD_SCRIPT=/cache/hfd.sh

# URL used to download hfd.sh when HFD_SCRIPT does not exist.
# Default: https://hf-mirror.com/hfd/hfd.sh
HFD_URL=https://hf-mirror.com/hfd/hfd.sh

# hfd.sh backend downloader. Common values: aria2c, wget.
# Default: aria2c
HFD_TOOL=aria2c

# Parallel download connections passed to hfd.sh.
# Default: 8
HFD_THREADS=8

# Hugging Face model repo to download when MODEL_DIR is incomplete.
# Default: fishaudio/s2-pro
MODEL_ID=fishaudio/s2-pro

# Model path used by SGLang inside the runtime environment.
# Docker default: /models/s2-pro
MODEL_DIR=/models/s2-pro

# Files that must exist in MODEL_DIR before the worker considers the model complete.
# Default: codec.pth plus the two S2-Pro safetensors shards
MODEL_REQUIRED_FILES="codec.pth model-00001-of-00002.safetensors model-00002-of-00002.safetensors"

# Runtime cache directory for temporary files and downloaded references.
# Default: /cache
CACHE_DIR=/cache

# Host/IP where the managed SGLang server listens.
# Docker default: 0.0.0.0, exposed to the host by docker-compose.yml.
SGLANG_HOST=0.0.0.0

# Port where the managed SGLang server listens.
# Default: 8000
SGLANG_PORT=8000

# Base SGLang-Omni pipeline config. Startup scripts copy this and append runtime overrides.
# Default: configs/s2pro_tts.yaml
SGLANG_CONFIG=configs/s2pro_tts.yaml

# Worker-advertised SGLang running request limit. Keep aligned with SGLANG_TTS_MAX_RUNNING_REQUESTS.
# Default here: 1
SGLANG_MAX_RUNNING_REQUESTS=1

# Worker-advertised SGLang queue limit. Set 0 to reject overload immediately.
# Default here: 0
SGLANG_MAX_QUEUED_REQUESTS=0

# Extra CLI args appended to `sgl-omni serve`. Leave empty unless a known SGLang flag is needed.
# Default: empty
SGLANG_EXTRA_ARGS=

# S2-Pro engine static memory fraction for model weights and KV/cache pools.
# Default for 24GB GPUs: 0.35
SGLANG_TTS_MEM_FRACTION_STATIC=0.35

# S2-Pro engine internal concurrency. Increase only when short-request throughput needs it and VRAM is stable.
# Default for 24GB GPUs: 1
SGLANG_TTS_MAX_RUNNING_REQUESTS=1

# Default max generated audio tokens when a request does not specify max_new_tokens.
# For S2-Pro, 2048 tokens is about 95 seconds of audio before truncation on 24GB GPUs.
# Default for 24GB GPUs: 2048
SGLANG_TTS_MAX_NEW_TOKENS=2048

# Enable S2-Pro torch compile path: 1 on, 0 off. Off is safer and uses less startup memory.
# Default for 24GB GPUs: 0
SGLANG_TTS_TORCH_COMPILE=0

# Enable CUDA graph capture: 1 on, 0 off. Off is safer on 24GB GPUs.
# Default for 24GB GPUs: 0
SGLANG_TTS_CUDA_GRAPH=0

# CUDA allocator setting that reduces fragmentation during long S2-Pro decode.
# Default for 24GB GPUs: expandable_segments:True
PYTORCH_ALLOC_CONF=expandable_segments:True

# Seconds to wait for SGLang /health before failing worker startup.
# Default: 900
SGLANG_STARTUP_TIMEOUT_SECONDS=900

# Whether the worker starts and owns the SGLang process. Set 0 to connect to an external SGLang server.
# Default: 1
WORKER_MANAGE_SGLANG=1

# Seconds between worker heartbeat/status messages sent to the manager.
# Default: 5
HEARTBEAT_INTERVAL_SECONDS=5
