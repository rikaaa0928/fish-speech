# Manager WebSocket endpoint used by this GPU worker to register itself.
# Default/example: wss://manager.example.com/internal/workers/ws
MANAGER_URL=wss://manager.example.com/internal/workers/ws

# Shared worker registration token. Must match the manager-side worker token.
# Default/example: replace-me
WORKER_TOKEN=replace-me

# Optional stable worker ID. Leave empty to generate worker-<random> on startup.
# Default: empty
WORKER_ID=

# Docker host directory mounted into the container for model files.
# Default: ./models
HOST_MODEL_DIR=./models

# Docker host directory mounted into the container for cache/download files.
# Default: ./cache
HOST_CACHE_DIR=./cache

# Docker host directory mounted into the container for Fish API server references.
# Default: ./references
HOST_REFERENCES_DIR=./references

# Container path corresponding to HOST_MODEL_DIR.
# Default: /models
CONTAINER_MODEL_DIR=/models

# Container path corresponding to HOST_CACHE_DIR.
# Default: /cache
CONTAINER_CACHE_DIR=/cache

# Container path corresponding to HOST_REFERENCES_DIR.
# Must match API_SERVER_REFERENCES_DIR when using Docker.
# Default: /app/references
CONTAINER_REFERENCES_DIR=/app/references

# Hugging Face endpoint used by download tools. Use https://huggingface.co if no mirror is needed.
# Default: https://hf-mirror.com
HF_ENDPOINT=https://hf-mirror.com

# Path where hfd.sh is stored. Docker default is /cache/hfd.sh.
# Default: /cache/hfd.sh
HFD_SCRIPT=/cache/hfd.sh

# URL used to download hfd.sh when HFD_SCRIPT does not exist.
# Default: https://hf-mirror.com/hfd/hfd.sh
HFD_URL=https://hf-mirror.com/hfd/hfd.sh

# hfd.sh backend downloader. Common values: aria2c, wget.
# Default: aria2c
HFD_TOOL=aria2c

# Parallel download connections passed to hfd.sh.
# Default: 8
HFD_THREADS=8

# Hugging Face model repo to download when MODEL_DIR is incomplete.
# Default: fishaudio/s2-pro
MODEL_ID=fishaudio/s2-pro

# Model path used by the Fish API server inside the runtime environment.
# Docker default: /models/s2-pro
MODEL_DIR=/models/s2-pro

# Files that must exist in MODEL_DIR before the worker considers the model complete.
# Default: codec.pth plus the two S2-Pro safetensors shards
MODEL_REQUIRED_FILES="codec.pth model-00001-of-00002.safetensors model-00002-of-00002.safetensors"

# Runtime cache directory for temporary files and downloaded references.
# Default: /cache
CACHE_DIR=/cache

# Host/IP where the managed Fish API server listens.
# Docker default: 0.0.0.0, exposed to the host by docker-compose.yml.
API_SERVER_HOST=0.0.0.0

# Port where the managed Fish API server listens.
# Default: 8000
API_SERVER_PORT=8000

# Optional URL used by the worker to reach an external Fish API server.
# Leave empty when WORKER_MANAGE_API_SERVER=1.
API_SERVER_URL=

# Decoder checkpoint passed to tools/api_server.py.
# Default: ${MODEL_DIR}/codec.pth
API_SERVER_DECODER_CHECKPOINT_PATH=/models/s2-pro/codec.pth

# Decoder config name passed to tools/api_server.py.
# Default: modded_dac_vq
API_SERVER_DECODER_CONFIG_NAME=modded_dac_vq

# Worker local running request limit. This is enforced before requests reach the API server.
# Default here: 1
API_SERVER_MAX_RUNNING_REQUESTS=1

# Worker local queue limit. Set 0 to reject overload immediately.
# Default here: 1
API_SERVER_MAX_QUEUED_REQUESTS=1

# Default max generated audio tokens when a request does not specify max_new_tokens.
# Default here: 1024
API_SERVER_TTS_MAX_NEW_TOKENS=1024

# Enable Fish API server torch compile path: 1 on, 0 off.
# Recommended/default for 4090D testing: 1
API_SERVER_COMPILE=1

# Enable float16 precision: 1 on, 0 off. Off uses bfloat16 and was more stable in testing.
# Default here: 0
API_SERVER_HALF=0

# Number of Uvicorn worker processes. Keep 1 unless each process can fit a full model copy in VRAM.
# Default here: 1
API_SERVER_WORKERS=1

# API server text length guard. 0 disables the guard; set around 240 for 24GB GPUs if desired.
# Default here: 0
API_SERVER_MAX_TEXT_LENGTH=0

# Audio speed adjustment implementation: librosa preserves pitch; linear
# matches SGLang-Omni's lightweight interpolation and changes pitch.
# Default: librosa
API_SERVER_SPEED_METHOD=librosa

# Directory where Fish API server stores references/{reference_id}/sample.* and sample.lab.
# Relative paths are resolved from the repository root because the worker starts there.
# Default here: references
API_SERVER_REFERENCES_DIR=references

# Extra CLI args appended to tools/api_server.py. Leave empty unless a known API server flag is needed.
# Default: empty
API_SERVER_EXTRA_ARGS=

# CUDA allocator setting that reduces fragmentation during long S2-Pro decode.
# Default: expandable_segments:True
PYTORCH_ALLOC_CONF=expandable_segments:True

# Seconds to wait for /v1/health before failing worker startup.
# Default: 900
API_SERVER_STARTUP_TIMEOUT_SECONDS=900

# Whether the worker starts and owns the Fish API server process. Set 0 to connect to API_SERVER_URL.
# Default: 1
WORKER_MANAGE_API_SERVER=1

# Seconds between worker heartbeat/status messages sent to the manager.
# Default: 5
HEARTBEAT_INTERVAL_SECONDS=5

# Require a usable GPU for this worker. When enabled, heartbeat performs GPU-aware
# health checks and the watchdog exits the container after repeated GPU failures.
# Default: 1
WORKER_REQUIRE_GPU=1

# Seconds between CUDA tiny-op probes once /v1/health is OK.
# Default: 30
CUDA_PROBE_INTERVAL_SECONDS=30

# Timeout for the CUDA tiny-op probe.
# Default: 10
CUDA_PROBE_TIMEOUT_SECONDS=10

# Consecutive GPU/NVML/CUDA probe failures before the worker exits with code 70.
# Docker Compose restart policy should then recreate the container.
# Default: 2
GPU_WATCHDOG_FAILURES_BEFORE_EXIT=2

# Consecutive Fish API server health/inference failures before restarting only
# the managed API server child process.
# Default: 3
API_SERVER_WATCHDOG_FAILURES_BEFORE_RESTART=3

# Minimum seconds between managed API server restarts.
# Default: 30
API_SERVER_RESTART_COOLDOWN_SECONDS=30
